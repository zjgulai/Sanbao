{
  "name": "dsh-onboarding-carousel",
  "description": "Sanbao first-run product-intro carousel contributed as an official settings.onboarding step.",
  "version": "0.1.0-local.1",
  "luteOrigin": "self",
  "luteOwner": "lute",
  "lutePublish": false,
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "react",
        "react/jsx-runtime"
      ]
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/validate-build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "tsdown": "^0.22.14",
    "typescript": "5.6.3",
    "vitest": "^4.1.10"
  }
}
