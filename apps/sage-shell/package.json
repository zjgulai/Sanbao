{
  "name": "sage-shell",
  "productName": "Sage",
  "version": "0.1.0",
  "luteOrigin": "self",
  "luteOwner": "lute",
  "lutePublish": false,
  "private": true,
  "description": "Sage 自有 Electron 薄壳：用 npm 上的 harness 运行时启动 cordis host，脱离 dsh-desktop fork",
  "type": "module",
  "main": "lib/main/index.js",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/build-renderer.mjs",
    "test": "node scripts/test.mjs run",
    "materialize": "node scripts/materialize.mjs",
    "preview": "node scripts/preview.mjs",
    "smoke": "node scripts/smoke.mjs",
    "dev": "tsc && node scripts/build-renderer.mjs && electron .",
    "dev:debug": "node scripts/dev-debug.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@deepseek-ai/dsh-api-gateway": "0.2.0-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-modules": "0.2.0-rc.2",
    "@deepseek-ai/dsh-cmdline": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2",
    "@types/node": "^22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "43.3.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.6.3",
    "vitest": "^4.1.11"
  }
}
