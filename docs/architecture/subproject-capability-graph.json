  "seams": [
    {
      "id": "S0-runtime-composition",
      "relationship_card": "seam-relationship-cards.md#s0-runtime-composition",
      "priority": "first",
      "owner": "工程与发布",
      "boundary": "源码、profile file 依赖、bundle 注册、宿主加载",
      "problem": "声明、安装、注册和实机生效容易被误当作同一件事。",
      "contract": "每一步分别记录 declared、installed、bundled、live 四种读数；profile metadata、files 和 bundle 三面门禁共同覆盖声明与装载前契约。",
      "rollback": "保留原 profile 与 bundle 组合，按既有同步流程回退。",
      "verification": "门禁读数加目标宿主的显式加载与行为检查。"
    },
    {
      "id": "S0-service-consumption",
      "relationship_card": "seam-relationship-cards.md#s0-service-consumption",
      "priority": "first_code_pilot",
      "owner": "插件契约",
      "boundary": "服务提供者、inject 声明、消费者读取与失败处理",
      "problem": "同一行多次 ctx.get 调用的检测盲区会让可选服务契约遗漏。",
      "contract": "服务消费者明确 inject、可选读取和保守失败行为；检测器可定位全部同类调用。",
      "rollback": "仅回退检测器和其最小测试，不改变业务服务数据。",
      "verification": "先补 Red/Green 测试，再运行相关门禁。"
    },
    {
      "id": "S1-work-item-identity",
      "relationship_card": "seam-relationship-cards.md#s1-work-item-identity",
      "priority": "after_product_D3",
      "owner": "产品与数据模型",
      "boundary": "Task Board、Agent Team、LoopX、DeepResearch、Qoder 活动的工作对象",
      "problem": "这些面当前有各自工作状态；尚无已证实的统一 work item 身份。",
      "contract": "先确定一个用户价值流和主身份，再定义映射、生命周期、权限与审计边界。",
      "rollback": "在统一身份得到验证前，各模块保留原有本地身份。",
      "verification": "跨模块场景回放、重复项和状态漂移检查。"
    },
    {
      "id": "S1-host-portability",
      "relationship_card": "seam-relationship-cards.md#s1-host-portability",
      "priority": "after_host_choice",
      "owner": "宿主与发布",
      "boundary": "DSH Desktop 与 Lute Shell 的运行和发布路径",
      "problem": "两条宿主路径的依赖、装配和验收不可默认等价。",
      "contract": "按能力建立宿主兼容性矩阵，逐项给出支持、降级、数据边界和验收方式。",
      "rollback": "保留 DSH Desktop 作为已存在的优先宿主路径。",
      "verification": "同一最小场景在两宿主独立验收。"
    },
    {
      "id": "S2-slot-renderer-boundary",
      "relationship_card": "seam-relationship-cards.md#s2-slot-renderer-boundary",
      "priority": "before_surface_change",
      "owner": "表面模块与渲染",
      "boundary": "官方 slot、二开挂载点和整块 renderer shadow",
      "problem": "加性 slot 与整块替换的升级风险不同，未经识别会导致版本升级或样式变更失效。",
      "contract": "每个界面改动先标明 slot、owner、输入输出和回退点；无可验证语义时不得假设挂载稳定。",
      "rollback": "移除独立挂载或恢复既有 renderer 路径。",
      "verification": "DOM/ARIA 语义、运行时视觉和交互回归。"
    }
  ],
